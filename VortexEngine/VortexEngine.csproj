<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7"/>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2"/>
    <PackageReference Include="Vortice.ShaderCompiler" Version="1.9.0" />
    <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
    <PackageReference Include="Vortice.VulkanMemoryAllocator" Version="1.7.0" />
  </ItemGroup>

</Project>
